{
  "name": "nexubis-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "blog:generate-index": "tsx scripts/generate-blog-index-data.ts",
    "blog:generate-fixtures": "tsx scripts/generate-blog-post-fixtures.ts",
    "blog:migrate-batch": "sanity exec scripts/migrate-blog-sanity-batch.ts --with-user-token --",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "funnelr:inspect": "tsx scripts/funnelr-inspect.ts",
    "funnelr:verify:nexubis": "tsx scripts/funnelr-verify-nexubis-readonly.ts",
    "funnelr:verify:lekkeweb": "tsx scripts/funnelr-verify-lekkeweb-readonly.ts",
    "test:funnelr": "npm run funnelr:inspect",
    "test:funnelr:write": "tsx scripts/test-funnelr-write.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@portabletext/react": "^7.0.1",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sanity/image-url": "^2.1.1",
    "@upstash/redis": "^1.38.0",
    "agentation": "^3.0.1",
    "cheerio": "^1.2.0",
    "gsap": "^3.12.7",
    "lottie-web": "^5.13.0",
    "next": "^16.2.9",
    "next-sanity": "^13.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.1",
    "sanity": "^6.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "playwright-core": "^1.61.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
