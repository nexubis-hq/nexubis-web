# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.vercel-old-link

# typescript
*.tsbuildinfo
next-env.d.ts

# ShipStudio metadata
.shipstudio/

# Local Webflow export reference. Rebuild from this into components; do not deploy wholesale.
/webflow-export/

# local tooling artifacts
/.playwright-mcp/
/qa/
/test-results/
/.tmp-sanity-import/

# Local reference material (contains the LekkeWeb audit-tool snapshot with live API keys). Never commit.
/reference/
/offline-package/

# Local Funnelr migration/read-back evidence can contain live contact data.
/docs/funnelr-snapshots/

.vercel
