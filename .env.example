FUNNELR_API_KEY=
FUNNELR_API_BASE_URL=
FUNNELR_TEST_CONTACT_EMAIL=
FUNNELR_TEST_LIST_ID=
FUNNELR_TEST_TAG_ID=
CAL_WEBHOOK_SECRET=
CAL_APPLICATION_EVENT_SLUG=
RESEND_API_KEY=
CONTACT_EMAIL_FROM=Nexubis Onboarding <hello@nexubis.io>
NEXT_PUBLIC_SANITY_PROJECT_ID=tu3u3e8c
NEXT_PUBLIC_SANITY_DATASET=production

# --- Meta pixel + Conversions API ---
# Pixel id (public; ships in page source). Falls back to the hardcoded dataset id.
NEXT_PUBLIC_META_PIXEL_ID=885652097948360
# CAPI access token. Production ONLY — never add to Preview (tracking is host-gated
# and must stay inert on previews). Without it the server leg logs loudly and skips.
META_CAPI_TOKEN=
# Force tracking on a non-production host (localhost/preview) for verification. Unset in prod.
NEXT_PUBLIC_META_TRACKING_FORCE=
# Test Events code. Set either name (both are read); the server leg attaches it so
# server events route into Events Manager > Test Events. Browser events appear
# there automatically (the pixel has no test_event_code param), so a deduplicated
# pair can be confirmed. Temporary/testing only — leave unset in prod.
META_TEST_EVENT_CODE=
NEXT_PUBLIC_META_TEST_EVENT_CODE=
# Expected event values (deal size x close rate). Currency defaults to ZAR (the ad
# account's currency). Left unset = no value sent. Lead is public so the pixel leg
# can send it too; Schedule is server-only.
NEXT_PUBLIC_META_LEAD_VALUE=
META_SCHEDULE_VALUE=
META_CURRENCY=ZAR
